# ── Base de Datos MySQL ──────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=nutribi

# ── Google Gemini (Text-to-SQL) ─────────────────────────
GEMINI_API_KEY=TU_API_KEY

# ── Modelo de IA (opcional, default: gemini-2.0-flash) ──
AI_MODEL=gemini-2.0-flash

# ── Autenticación JWT ───────────────────────────────────
JWT_SECRET=tu_secreto_jwt

# ── Servidor ─────────────────────────────────────────────
PORT=3000

# ── CORS (en producción: URL del frontend en Render) ────
# CORS_ORIGIN=https://nutribi-frontend.onrender.com
